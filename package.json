{
  "name": "gatekit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "typecheck:examples": "pnpm -r --filter \"./examples/*\" typecheck",
    "test": "vitest run",
    "examples": "pnpm -r --filter \"./examples/*\" smoke"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
